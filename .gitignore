# =============================================================================
# ReasonLoop Project - Reversed Ruleset .gitignore
# =============================================================================
# Strategy: Ignore everything (*), then whitelist what should be tracked (!)
# This ensures only intentional files are committed.
# =============================================================================

# Ignore everything by default
*

# =============================================================================
# Root Files - Whitelist
# =============================================================================
!.gitignore
!.env.example
!README.md
!CHANGELOG.md
!ARCHITECTURE.md
!AGENT_START_HERE.xml
!main.py
!run_api.py
!pyproject.toml
!poetry.lock
!requirements.txt
!create_admin_tables.sql

# =============================================================================
# Configuration - Whitelist
# =============================================================================
!.claude/
!.claude/**
!.githooks/
!.githooks/**

!config/
!config/__init__.py
!config/logging_config.py
!config/settings.py
!config/settings.json.example
# NOTE: config/settings.json is NOT tracked (contains local settings)

# =============================================================================
# Core Application - Whitelist
# =============================================================================
!core/
!core/__init__.py
!core/*.py

!models/
!models/__init__.py
!models/*.py

!utils/
!utils/__init__.py
!utils/*.py

# =============================================================================
# Abilities (Agent Functions) - Whitelist
# =============================================================================
!abilities/
!abilities/__init__.py
!abilities/*.py

# =============================================================================
# Agents (Templates & Roles) - Whitelist
# =============================================================================
!agents/
!agents/__init__.py
!agents/*.md
!agents/roles/
!agents/roles/*.md
# NOTE: agents/created/ is NOT tracked (auto-generated)

# =============================================================================
# API Server - Whitelist
# =============================================================================
!api/
!api/__init__.py
!api/*.py
!api/core/
!api/core/__init__.py
!api/core/*.py
!api/routes/
!api/routes/__init__.py
!api/routes/*.py
!api/schemas/
!api/schemas/__init__.py
!api/schemas/*.py

# =============================================================================
# Database Schemas - Whitelist
# =============================================================================
!database/
!database/*.sql

# =============================================================================
# Documentation - Whitelist
# =============================================================================
!DOCS/
!DOCS/**
!docs/
!docs/**
!PRP/
!PRP/**

# =============================================================================
# Scripts - Whitelist
# =============================================================================
!scripts/
!scripts/*.sh
!scripts/*.py

# =============================================================================
# Package Module - Whitelist
# =============================================================================
!reasonloop/
!reasonloop/__init__.py

# =============================================================================
# Experiments (optional tracking) - Whitelist
# =============================================================================
!experiments/
!experiments/*.py
!experiments/segmentation/
!experiments/segmentation/*.py
!experiments/tests/
!experiments/tests/*.py

# =============================================================================
# NEVER TRACK - Explicit Exclusions (override any whitelist above)
# =============================================================================
# These patterns ensure sensitive/generated files are never tracked,
# even if a parent directory is whitelisted.

# Environment & Secrets
.env
.env.*
*.env
auth.json

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# IDE/Editor files
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Generated output (runtime data)
output/
sessions/
logs/
metrics/
*.log

# Build artifacts
build/
dist/
*.manifest

# Test/Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Jupyter
.ipynb_checkpoints/

# Auto-generated agents
agents/created/
agents/meta_agent_creator*.md
