# ReasonLoop Configuration Example
# Copy this file to .env and customize your settings

# ==============================================
# GENERAL SETTINGS
# ==============================================

# Default objective for the system
DEFAULT_OBJECTIVE=Create a 3-day itinerary for Bangkok

# Prompt template to use for task generation
# Options: default_tasks, marketing_insights, propensity_modeling
PROMPT_TEMPLATE=default_tasks

# Retry configuration
MAX_RETRIES=2
RETRY_DELAY=2.0

# ==============================================
# LLM PROVIDER CONFIGURATION
# ==============================================

# Primary LLM provider (ollama, anthropic, openai)
LLM_PROVIDER=ollama

# LLM parameters
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_REPEAT_PENALTY=1.1
LLM_TOP_P=0.8
LLM_SEED=42
LLM_NUM_CTX=2048

# ==============================================
# OLLAMA CONFIGURATION
# ==============================================

# Ollama API endpoint
OLLAMA_API_URL=http://localhost:11434/api/generate

# Default Ollama model (for backward compatibility)
OLLAMA_MODEL=minimax-m2:cloud

# ==============================================
# MULTI-AGENT OLLAMA MODELS
# ==============================================

# Orchestrator model - handles coordination and delegation tasks
OLLAMA_MODEL_ORCHESTRATOR=minimax-m2:cloud

# Planner model - handles strategic planning, task creation, design tasks
# Uses larger model for complex reasoning
OLLAMA_MODEL_PLANNER=gpt-oss:120b-cloud

# Executor model - handles content generation, implementation, writing tasks
OLLAMA_MODEL_EXECUTOR=gpt-oss:20b-cloud

# Reviewer model - handles analysis, evaluation, validation, review tasks
OLLAMA_MODEL_REVIEWER=gpt-oss:20b-cloud

# ==============================================
# ANTHROPIC CONFIGURATION (OPTIONAL)
# ==============================================

# Anthropic API settings
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# ==============================================
# OPENAI CONFIGURATION (OPTIONAL)
# ==============================================

# OpenAI API settings
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# ==============================================
# DATABASE CONFIGURATION
# ==============================================

# MySQL database connection settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_password_here
DB_DATABASE=reasonloop

# ==============================================
# WEB SEARCH CONFIGURATION
# ==============================================

# Enable/disable web search functionality
WEB_SEARCH_ENABLED=true

# Number of search results to return
WEB_SEARCH_RESULTS_COUNT=5

# ==============================================
# SECURITY NOTES
# ==============================================

# 1. Never commit this file to version control
# 2. Use strong passwords for database connections
# 3. Rotate API keys regularly
# 4. Use environment-specific files (.env.development, .env.production)
# 5. Ensure proper file permissions (600 or 644)

# ==============================================
# AVAILABLE MODELS REFERENCE
# ==============================================

# Based on your local Ollama installation:
# - glm-4.6:cloud
# - minimax-m2:cloud  
# - mxbai-embed-large:latest
# - nomic-embed-text:latest
# - gpt-oss:120b-cloud
# - gpt-oss:20b-cloud
# - gemma3:1b
# - embeddinggemma:latest
# - llama3.2:1b-instruct-q4_K_M
# - llama3.2:3b-instruct-q4_K_M
# - phi3:instruct
# - qwen2.5vl:7b
# - qwen3:4b-instruct
# - qwen3:latest
# - qwen2.5vl:latest
# - qwen3:4b

# To verify available models: ollama list
# To pull new models: ollama pull model_name